# 知乎开放平台 Access Secret（https://developer.zhihu.com/profile）
ZHIHU_ACCESS_SECRET=

# AI 提供方：dashscope（通义，默认）或 zhida（知乎直答）
LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
ZHIDA_MODEL=zhida-fast-1p5

# 知乎登录（黑客松活动页创建项目后获得）；回调地址必须与活动页登记值完全一致
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=https://runbol.cn/api/auth/callback

# 体验模式（读取 Access Secret 本人的公开收藏夹作为示例）；off 关闭
DEMO_MODE=on
